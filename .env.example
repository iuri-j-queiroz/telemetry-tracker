# Copy this file to .env and change the values.
# The .env file stays on your machine. Never commit it.

# Ports and service URLs
SERVER_PORT=5001
APP_PORT=5000
BUILDER_PORT=5002
SERVER_URL=http://127.0.0.1:5001
BUILDER_URL=http://127.0.0.1:5002

# Shared secret between the builder and the server.
# The server refuses registrations without this token.
BUILDER_TOKEN=change-me

# LLM for the builder and the driver chat (OpenAI-compatible endpoint).
# Keep LLM_MOCK=1 to run without a key. The mock returns known-good analyses.
LLM_MOCK=1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# F1TV access for live timing (M5).
# Leave empty. The app asks for access before live timing.
F1TV_TOKEN=
